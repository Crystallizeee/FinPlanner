APP_NAME="Financial Vault RPG"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL Database Configuration
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=financial_vault
DB_USERNAME=vault_user
DB_PASSWORD=vault_secret_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# API Mutasi Webhook Secret
API_MUTASI_SECRET=financial_planner_secret_token
TESSERACT_OCR_PATH=/usr/bin/tesseract
